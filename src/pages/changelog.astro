---
import Layout from '../layouts/Layout.astro';
import changelogMarkdown from '../content/changelog.md?raw';
import { renderMarkdownWithCodeCopyButtons } from '../lib/markdown';

const html = renderMarkdownWithCodeCopyButtons(changelogMarkdown);
---

<Layout title="バージョン履歴 | Nyamuru 🐱 Image Hub" description="Nyamuru 🐱 Image Hubのバージョン履歴・更新内容">
  <main class="changelog-page">
    <nav><a href="/">← アプリへ戻る</a></nav>
    <header>
      <span>VERSION HISTORY</span>
      <h1>バージョン履歴</h1>
      <p>基盤となったNyamuru Manga Name Studioの更新履歴です。</p>
    </header>

    <article class="changelog-md" set:html={html} />
  </main>
</Layout>

<style>
  :global(body) { overflow: auto; }
  .changelog-page { width: min(860px, calc(100% - 32px)); margin: 0 auto; padding: 32px 0 64px; }
  nav { margin-bottom: 32px; }
  a { color: var(--accent-dark); font-weight: 700; text-decoration: none; }
  a:hover { text-decoration: underline; }
  header { padding: 30px; border: 1px solid var(--line); border-radius: 18px; background: linear-gradient(135deg, var(--accent-soft), var(--control)); }
  header span { color: var(--accent-dark); font: 800 10px/1 monospace; letter-spacing: .16em; }
  h1 { margin: 10px 0 12px; font-size: clamp(26px, 5vw, 42px); }
  p { margin: 0; color: #606572; line-height: 1.85; }

  /* 本文は src/content/changelog.md をビルド時にレンダリング */
  .changelog-md { margin-top: 20px; padding: 24px; border: 1px solid var(--soft-line); border-radius: 14px; background: rgba(255,255,255,.96); }
  .changelog-md :global(h1) { display: none; } /* md先頭の見出しは上のページヘッダーと重複するため非表示 */
  .changelog-md :global(h2) { margin: 28px 0 4px; padding: 24px 0 0; border-top: 1px solid var(--soft-line); font-size: 20px; color: var(--accent-dark); }
  .changelog-md :global(h2:first-of-type) { margin-top: 0; padding-top: 0; border-top: none; }
  .changelog-md :global(h2 + p) { margin: 0 0 10px; color: var(--muted); font: 700 11px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .changelog-md :global(ul) { margin: 0; padding-left: 22px; }
  .changelog-md :global(li) { margin: 6px 0; color: #5e5a64; line-height: 1.75; }
  .changelog-md :global(a) { color: var(--accent-dark); font-weight: 700; text-decoration: none; }
  .changelog-md :global(a:hover) { text-decoration: underline; }
  .changelog-md :global(p) { margin: 12px 0 0; font-size: 13px; }

  @media (max-width: 560px) {
    .changelog-page { width: min(100% - 20px, 860px); padding-top: 20px; }
    header, .changelog-md { padding: 18px; }
  }
</style>
