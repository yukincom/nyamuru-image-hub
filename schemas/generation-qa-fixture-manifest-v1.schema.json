{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-qa-fixture-manifest-v1.schema.json",
  "title": "Nyamuru synthetic generation QA fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "kind", "cases"],
  "properties": {
    "schema_name": { "const": "nyamuru-generation-qa-fixture-manifest" },
    "schema_version": { "const": 1 },
    "kind": { "const": "project-generated-synthetic" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "file_name",
        "artifact_sha256",
        "source_snapshot_sha256",
        "expected_status",
        "expected_finding_codes",
        "expected_pixel_semantics"
      ],
      "properties": {
        "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
        "file_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.png$" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "expected_status": { "enum": ["pass", "warn", "fail"] },
        "expected_finding_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "expected_pixel_semantics": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
