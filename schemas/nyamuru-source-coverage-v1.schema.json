{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyamuru.local/schemas/nyamuru-source-coverage-v1.schema.json",
  "title": "Nyamuru source coverage report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "kind", "episode", "source", "omny",
    "analysis_sha256", "scan_complete", "verdict", "summary", "warnings",
    "source_units", "targets", "human_decisions"
  ],
  "properties": {
    "schema_name": { "const": "nyamuru-source-coverage" },
    "schema_version": { "const": 1 },
    "kind": { "const": "source_coverage_report" },
    "episode": { "$ref": "#/$defs/episode" },
    "source": { "$ref": "#/$defs/source" },
    "omny": { "$ref": "#/$defs/omny" },
    "analysis_sha256": { "$ref": "#/$defs/sha256" },
    "scan_complete": { "const": true },
    "verdict": { "enum": ["no_review_required", "review_required", "reviewed_with_gaps"] },
    "summary": { "$ref": "#/$defs/summary" },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "content" } }
      },
      "items": { "$ref": "#/$defs/source_unit" }
    },
    "targets": {
      "type": "array",
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/target" }
    },
    "human_decisions": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/human_decision" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_id": { "type": "string", "pattern": "^source-[a-f0-9]{64}$" },
    "target_id": { "type": "string", "pattern": "^target-[a-f0-9]{64}$" },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_id", "episode_id", "title", "episode_number"],
      "properties": {
        "series_id": { "type": "string", "maxLength": 1000 },
        "episode_id": { "type": "string", "maxLength": 1000 },
        "title": { "type": "string", "maxLength": 5000 },
        "episode_number": { "type": "string", "maxLength": 1000 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "relative_path", "byte_size", "line_count", "source_text_sha256", "source_revision_sha256"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\\\u0000]+$" },
        "relative_path": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$" }
          ]
        },
        "byte_size": { "type": "integer", "minimum": 1, "maximum": 5242880 },
        "line_count": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "source_text_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "omny": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omny_revision_sha256", "projection_sha256"],
      "properties": {
        "omny_revision_sha256": { "$ref": "#/$defs/sha256" },
        "projection_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_units", "confirmed", "ambiguous", "unverified", "excluded",
        "context_only", "current_decisions", "stale_decisions", "unresolved_after_review"
      ],
      "properties": {
        "source_units": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "confirmed": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "ambiguous": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "unverified": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "excluded": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "context_only": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "current_decisions": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "stale_decisions": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "unresolved_after_review": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "source_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_unit_id", "kind", "start_line", "end_line", "excerpt", "match_text",
        "match_key", "speaker_hint", "status", "context_retained", "candidate_target_ids", "candidate_total"
      ],
      "properties": {
        "source_unit_id": { "$ref": "#/$defs/source_id" },
        "kind": { "enum": ["content", "excluded"] },
        "start_line": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "end_line": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "excerpt": { "type": "string", "maxLength": 2000 },
        "match_text": { "type": "string", "maxLength": 2000 },
        "match_key": { "type": "string", "maxLength": 2000 },
        "speaker_hint": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 100 }
          ]
        },
        "status": { "enum": ["confirmed", "ambiguous", "unverified", "excluded"] },
        "context_retained": { "type": "boolean" },
        "candidate_target_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target_id" }
        },
        "candidate_total": { "type": "integer", "minimum": 0, "maximum": 50000 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "layer", "kind", "locator", "value", "match_key", "speaker_keys"],
      "properties": {
        "target_id": { "$ref": "#/$defs/target_id" },
        "layer": { "enum": ["context_retained", "storyboard_evidenced"] },
        "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
        "locator": { "type": "string", "pattern": "^/", "maxLength": 2000 },
        "value": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "match_key": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "speaker_keys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_unit_id", "decision", "note", "source_revision_sha256", "projection_sha256", "stale"],
      "properties": {
        "source_unit_id": { "$ref": "#/$defs/source_id" },
        "decision": { "enum": ["covered", "not_covered", "not_applicable"] },
        "note": { "type": "string", "maxLength": 1000 },
        "source_revision_sha256": { "$ref": "#/$defs/sha256" },
        "projection_sha256": { "$ref": "#/$defs/sha256" },
        "stale": { "type": "boolean" }
      }
    }
  }
}
